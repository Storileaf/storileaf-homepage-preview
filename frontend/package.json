{
  "name": "@storileaf/public-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run content:gate && npm run guard:published && npm test",
    "content:gate": "node scripts/check-content.mjs",
    "guard:published": "node scripts/guard-published.mjs",
    "verify:group2": "node scripts/verify-group2-parity.mjs"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
