6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>Digital enhancement of photographs</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>A downloadable PDF e-book</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>Secure cloud storage for stories and photographs</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>12 months of guided access</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>Optional 3-month extension at a reduced price</span></li></ul><h4>Limits and scope</h4><ul class="pricing-detail-list"><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>800 words per answer</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>5 photographs per question</span></li><li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg><span>Voice recording with transcription included</span></li></ul></div></details></div></div><p class="pricing-product-qualification"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg>Standard shipping within India is listed as included. International shipping, customs and special delivery charges are additional.</p></div></section><section class="pricing-book-outcome" aria-labelledby="pricing-outcome-title"><div class="page-width pricing-outcome-grid"><div class="pricing-outcome-image"><img src="https://storileaf.com/images/brand/craft/storileaf-life-story-text-photo-spread-wide-1200.webp" alt="An open printed StoriLeaf story book with text and a photograph" width="1200" height="750" loading="lazy" decoding="async"/><span>What you make is real.</span></div><div class="pricing-outcome-copy"><h2 id="pricing-outcome-title">It begins with a question.<br/><em>It ends as a book.</em></h2><p>The package you choose shapes how much time and room you have to tell your story. It is your own words that make the pages yours.</p><ol><li><span>01</span><div><strong>Tell it a little at a time</strong><p>Use the guided questions and the contribution options in your package.</p></div></li><li><span>02</span><div><strong>Review the prepared book</strong><p>Once you submit, a draft is prepared for your review before printing.</p></div></li><li><span>03</span><div><strong>Keep the finished book</strong><p>Your package includes at least one printed book. Copies and finishing vary.</p></div></li></ol><a href="/storileaf-homepage-preview/#samples" class="text-link">Take a look inside <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"></path></svg></a></div></div></section><section class="pricing-faq" aria-labelledby="pricing-faq-title"><div class="page-width pricing-faq-grid"><div><h2 id="pricing-faq-title">A few things worth knowing <em>before you choose.</em></h2><p>A clear answer should make a choice easier, not more complicated.</p><a class="text-link" href="https://storileaf.com/contact/">Ask StoriLeaf <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"></path></svg></a></div><div class="pricing-faq-list"><details><summary><span>Is this a subscription?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>No. The listed package price is a one-time payment. Each package includes a defined period for writing your story. Optional extensions, where available, are separate purchases.</p></details><details><summary><span>Does paying mean my printed book arrives straight away?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>No. The storyteller answers guided questions, then submits their story for preparation. They review a prepared draft before the book goes to print. The writing-access period is not a delivery estimate.</p></details><details><summary><span>Is standard shipping included outside India?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>A free standard shipping inclusion applies to addresses within India only. International shipping, customs and special delivery charges can be additional. Currency selection does not set a delivery country.</p></details><details><summary><span>Can I add photographs or record my answers?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>That depends on the book and package. Travel Memoir includes photographs and voice transcription. Parent to Child Letters is a written-only experience without photograph uploads or voice recording. Always check the selected package details.</p></details><details><summary><span>Can I buy a book for someone else?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>Yes. A gifted purchase invites the recipient to tell their own story and review their draft. Buying the experience does not send a completed personalised book immediately or give the buyer access to the recipient’s private answers.</p></details><details><summary><span>Can I read my book before it goes to print?</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></summary><p>Yes. The storyteller reviews a prepared draft before production. Editorial feedback, guided calls, printed copies and finishing options vary by package.</p></details></div></div></section><section class="pricing-last-invitation"><div class="page-width pricing-last-row"><div><p class="pricing-mini-label">A little help deciding</p><h2>The right book is <em>the one you&#x27;ll want to return to.</em></h2></div><div><p>Compare what is included, or ask us which of the six books might suit your story.</p><a href="https://storileaf.com/contact/" class="button button-gold">Get in touch <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"></path></svg></a></div></div></section></main><footer class="site-footer"><div class="page-width"><div class="footer-grid"><div class="footer-brand"><a aria-label="StoriLeaf home" href="/storileaf-homepage-preview/#top" class="footer-logo"><img src="https://storileaf.com/logo.png" width="500" height="125" alt="StoriLeaf" loading="lazy"/></a><p>Real stories, made into books to keep and share.</p><label class="currency-picker"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><ellipse cx="12" cy="12" rx="4" ry="8.5"></ellipse><path d="M4 9h16M4 15h16"></path></svg><span class="sr-only">Currency for the pricing page</span><select aria-label="Pricing currency"><option value="inr" selected="">INR · ₹</option><option value="usd">USD · US$</option><option value="cad">CAD · C$</option><option value="gbp">GBP · £</option></select><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 4 8 8-8 8"></path></svg></label></div><div class="footer-column"><h3>The books</h3><a href="https://storileaf.com/life-story/">Life Story</a><a href="https://storileaf.com/travel-memoir/">Travel Memoir</a><a href="https://storileaf.com/relationship-memoir/">Relationship Memoir</a><a href="https://storileaf.com/founders-memoir/">Founder&#x27;s Memoir</a><a href="https://storileaf.com/parent-to-child-letters/">Parent to Child Letters</a><a href="https://storileaf.com/celebrating-occasions/">Celebrating Occasions</a></div><div class="footer-column"><h3>Explore</h3><a href="/storileaf-homepage-preview/#s